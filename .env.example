# Required — copy this file to .env and fill in your addresses

# Your Bitcoin address (required).
# Registers your node on unatrare.wtf/nodes and qualifies you for future operator rewards.
BTC_ADDRESS=

# Your Counterparty (XCP) address (optional).
# Shown on your node card at unatrare.wtf/nodes.
XCP_ADDRESS=

# Your TAP Protocol address (optional).
# Used for future UNATPEPE holder rewards.
TAP_ADDRESS=
